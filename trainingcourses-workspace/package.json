{
  "name": "trainingcourses-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:libs:sessions": "ng build training-sessions",
    "build:libs:dtbc-core": "ng build dtbc-core",
    "build:libs": "npm run build:libs:dtbc-core && npm run build:libs:sessions",
    "prestart": "npm run build:libs",
    "start": "ng serve --port=4201",
    "prebuild": "npm run build:libs",
    "build": "ng build main-application",
    "watch": "ng build main-application --watch --configuration development",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve:ssr:main-application": "node dist/main-application/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.1.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.1.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/ssr": "^20.0.3",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/postcss": "^4.1.13",
    "bootstrap": "^5.3.6",
    "express": "^5.1.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.13",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.3",
    "@angular/cli": "^20.0.3",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/localize": "^20.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.45.0",
    "@types/express": "^5.0.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "jsdom": "^25.0.1",
    "ng-packagr": "^20.0.0",
    "typescript": "~5.8.2",
    "vitest": "^2.1.3",
    "@vitest/ui": "^2.1.3",
    "@vitest/coverage-v8": "^2.1.3",
    "@testing-library/angular": "^18.0.0",
    "@testing-library/jest-dom": "^6.4.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}