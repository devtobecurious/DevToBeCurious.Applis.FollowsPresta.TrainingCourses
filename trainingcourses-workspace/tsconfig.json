/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "dtbc-core": [
        "./dist/dtbc-core"
      ],
      "training-sessions": [
        "./dist/training-sessions"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/main-application/tsconfig.app.json"
    },
    {
      "path": "./projects/main-application/tsconfig.spec.json"
    },
    {
      "path": "./projects/training-sessions/tsconfig.lib.json"
    },
    {
      "path": "./projects/training-sessions/tsconfig.spec.json"
    },
    {
      "path": "./projects/dtbc-core/tsconfig.lib.json"
    },
    {
      "path": "./projects/dtbc-core/tsconfig.spec.json"
    }
  ]
}
